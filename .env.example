# Copy to .env and adjust. Everything here is optional: the setup wizard (/install) stores
# site and telephony settings in the database, and those override these values.

PORT=3000
# DATA_DIR=./data                 # database + uploaded voice files (back this folder up)
# SESSION_SECRET=                 # random string; generated automatically if empty
# SECURE_COOKIES=1                # set when the site is served over HTTPS
# PUBLIC_URL=https://panel.example.com

# Skip the web wizard (e.g. automated deploys):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-now

# Display / numbers
# APP_NAME=IP Call Panel
# DISPLAY_TZ=Asia/Dhaka
# CURRENCY=৳
# DEFAULT_COUNTRY=BD              # BD = accept 01XXXXXXXXX; anything else = international format
# HELPLINE=
# ALLOW_REGISTER=0

# Call engine
# CALL_DRIVER=simulator           # simulator | asterisk
# SIM_SPEED=1                     # >1 makes simulated calls finish faster
# MAX_CONCURRENT=50               # system-wide simultaneous call limit

# Asterisk (CALL_DRIVER=asterisk)
# ARI_URL=http://127.0.0.1:8088
# ARI_USER=ipcall
# ARI_PASSWORD=
# ARI_APP=ipcall
# ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/ipcall   # same-server only
# ASTERISK_PJSIP_FILE=/etc/asterisk/pjsip_ipcall.conf   # same-server only
# SIP_PUBLIC_HOST=                # IP/domain shown to agents for their extensions
# ASTERISK_MOH_CLASS=default

# SQLITE_DRIVER=                  # force 'better' or 'node' (built-in, Node >= 22.5)
