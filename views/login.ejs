<%- include('partials/auth_head') %>
<div class="auth"><div class="box">
  <div class="brand"><span class="logo"><i class="bi bi-telephone-forward" style="color:#fff"></i></span><span><%= cfg.appName %></span></div>
  <h2 style="font-size:18px;margin-bottom:4px">Sign in</h2>
  <p class="muted" style="margin-top:0">Welcome back. Log in to manage your calls.</p>
  <% if (error) { %><div class="alert error"><i class="bi bi-exclamation-triangle"></i><%= error %></div><% } %>
  <form method="post" action="/login">
    <%- include('partials/csrf') %><input type="hidden" name="next" value="<%= next %>">
    <div class="field"><label>Username or email</label><input type="text" name="username" required autofocus autocomplete="username"></div>
    <div class="field"><label>Password</label><input type="password" name="password" required autocomplete="current-password"></div>
    <button class="btn block">Sign in</button>
  </form>
  <% if (cfg.allowRegister) { %><p class="center small mt">No account? <a href="/register">Create one</a></p><% } %>
  <% if (cfg.helpline) { %><p class="center small muted">Helpline: <%= cfg.helpline %></p><% } %>
</div></div>
</body></html>
