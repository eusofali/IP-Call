<%- include('partials/auth_head') %>
<div class="auth"><div class="box">
  <div class="brand"><span class="logo"><i class="bi bi-telephone-forward" style="color:#fff"></i></span><span><%= cfg.appName %></span></div>
  <h2 style="font-size:18px">Create account</h2>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/register">
    <%- include('partials/csrf') %>
    <div class="field"><label>Full name</label><input type="text" name="name" value="<%= form.name || '' %>" required></div>
    <div class="field"><label>Username</label><input type="text" name="username" value="<%= form.username || '' %>" required></div>
    <div class="field"><label>Email</label><input type="email" name="email" value="<%= form.email || '' %>"></div>
    <div class="field"><label>Mobile</label><input type="tel" name="phone" value="<%= form.phone || '' %>"></div>
    <div class="field"><label>Password</label><input type="password" name="password" minlength="8" required></div>
    <button class="btn block">Create account</button>
  </form>
  <p class="center small mt">Already registered? <a href="/login">Sign in</a></p>
</div></div>
</body></html>
